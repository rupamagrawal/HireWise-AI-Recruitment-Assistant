# ──────────────────────────────────────────────────
# LLM – Groq (primary, cloud)
# ──────────────────────────────────────────────────
# Obtain a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Fast, low-latency model on Groq.  Other options:
#   llama-3.3-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant

# ──────────────────────────────────────────────────
# LLM – Ollama (offline fallback)
# ──────────────────────────────────────────────────
# Used automatically when GROQ_API_KEY is not set
# or when the Groq API call fails / times out.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi

# ──────────────────────────────────────────────────
# Email (Gmail SMTP)
# ──────────────────────────────────────────────────
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
